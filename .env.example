# Local Hermes Web workspace development configuration.
# Keep real credentials in this ignored file; never commit them.

# Required by the current Hermes chat prototype.
HERMES_API_SERVER_URL=http://127.0.0.1:8642
API_SERVER_KEY=

# Hermes official Dashboard: management APIs (Cron, Skills, Config, API Keys).
# A private loopback Dashboard uses automatic local authentication.
HERMES_DASHBOARD_URL=http://127.0.0.1:8648
# Automatic connection needs a private Dashboard, not just a loopback URL.
# A public dashboard.public_url can enable Nous login even on a loopback bind.
# For an existing public Dashboard, run a separate private instance on e.g. 8649.
# See docs/hermes-private-dashboard.md and deploy/systemd/hermes-web-dashboard.service.example.
# Explicit tokens work only with backends that accept the native session token;
# they do not replace public Dashboard Nous/OAuth login.
# Optional persistent panel data directory (default: ~/.hermes-web).
# HERMES_WEB_DATA_DIR=/var/lib/hermes-web
# Optional shared/mounted project directory mapping to a remote Hermes host.
# HERMES_PROJECT_PATH_MAP='[{"local":"F:/Projects","remote":"/srv/projects"}]'
HERMES_DASHBOARD_SESSION_TOKEN=

# Panel login for local development; set a long random password.
PI_WEB_USERNAME=
PI_WEB_PASSWORD=
PI_WEB_ALLOWED_HOSTS=localhost,127.0.0.1

# Nous Portal login for a server deployment (separate from model-provider OAuth).
# Register this panel in https://portal.nousresearch.com/local-dashboards.
# Registered callback: https://your-domain/api/web-auth/official/callback
# A nonempty client ID enables the gate even if other settings are incomplete.
HERMES_WEB_OAUTH_CLIENT_ID=
HERMES_WEB_PUBLIC_URL=
# Optional restriction: exact Portal user IDs, comma-separated (not emails).
# Otherwise Portal's permission for this registered instance applies.
HERMES_WEB_OAUTH_ALLOWED_USERS=
